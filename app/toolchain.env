# The toolchain every build uses. app/build.sh, tools/settings-dump/build.sh,
# tools/apicheck.py and both GitHub workflows read this file, so a local build
# and a release are made with the same Android SDK packages. The build scripts
# stop when these versions are not installed; they never take another one.
#
# NAME=value lines only: sh sources this file and the workflows copy it into
# their environment.
#
# To change a version: edit it here, install it
# (sdkmanager "platforms;android-NN" "build-tools;N.N.N"), then run
# app/build.sh, app/test.sh and tools/apicheck.py.

# The platform the sources are compiled against (android.jar) and whose API
# table tools/apicheck.py reads. This is not the oldest Android the app runs
# on: that is minSdkVersion in the manifest.
ANDROID_PLATFORM=android-36

# aapt2, d8, zipalign and apksigner.
ANDROID_BUILD_TOOLS=36.0.0

# The JDK the workflows install (Temurin) and releases are compiled with.
# app/build.sh works with a newer one (JAVA_HOME), but javac's output differs
# between JDK versions, so only this version reproduces a release's classes.
JDK_VERSION=17
